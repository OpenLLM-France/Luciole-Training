# Copy to `.env` and edit. Used by docker-compose.yml.
#
# Up to four models (A, B, C, D) can be served side by side, each in its own
# vLLM container. Each MODEL_* is either a Hugging Face id, or a path INSIDE the
# container under /models (see MODELS_DIR below), e.g. /models/luciole-tool-sft.
#
# Each model is one self-contained block below: change a block's id, served
# name, tool parser, port and GPU-memory fraction to swap its size/memory,
# without touching the others.
#
# COMPOSE_PROFILES (in the Shared section) decides which models actually start —
# add/remove a letter to activate/deactivate a model without editing anything
# else, then re-run `docker compose up -d --remove-orphans`.

# === MODEL A ==============================================================
MODEL_A=OpenLLM-France/Luciole-8B-SFT-1.1
# Name the model is exposed as in the OpenAI API / Open WebUI picker.
SERVED_MODEL_NAME_A=luciole-8b
# Must match how your model emits tool calls (hermes | llama3_json | mistral | ...).
TOOL_PARSER_A=hermes
# Host port for curl/debugging (Open WebUI uses the compose network, not this).
VLLM_PORT_A=8000
# Fraction of (unified) GPU memory this instance may use (see note below).
GPU_MEM_UTIL_A=0.4

# === MODEL B ==============================================================
MODEL_B=OpenLLM-France/Luciole-1B-SFT-1.1
SERVED_MODEL_NAME_B=luciole-1b
TOOL_PARSER_B=hermes
VLLM_PORT_B=8001
GPU_MEM_UTIL_B=0.2

# === MODEL C ==============================================================
# A local checkpoint under MODELS_DIR, referenced as a /models path.
MODEL_C=/models/dpo_dolci_instruct_latest-step_1809
SERVED_MODEL_NAME_C=luciole-1b-2
TOOL_PARSER_C=hermes
VLLM_PORT_C=8002
GPU_MEM_UTIL_C=0.2

# === MODEL D ==============================================================
# A fourth, optional slot. Off by default (not in COMPOSE_PROFILES below).
MODEL_D=OpenLLM-France/Luciole-1B-SFT-1.1
SERVED_MODEL_NAME_D=luciole-1b-3
TOOL_PARSER_D=hermes
VLLM_PORT_D=8003
GPU_MEM_UTIL_D=0.2

# === Shared ===============================================================
# Which models to start (Compose profiles). Comma-separated letters, no spaces.
# Add a letter to activate that model, remove it to deactivate.
COMPOSE_PROFILES=a,b,c

# NVIDIA NGC vLLM container tag (ARM64/GB10 build for DGX Spark).
# Check the NGC catalog for the latest: catalog.ngc.nvidia.com/orgs/nvidia/containers/vllm
VLLM_TAG=26.02-py3

# Host dir holding local checkpoints; mounted to /models in the container.
MODELS_DIR=./models

# Host Hugging Face cache (avoids re-downloading on restart).
HF_CACHE=~/.cache/huggingface

# Needed only for gated/private HF models.
HF_TOKEN=

# GPUs to give vLLM: a number (e.g. 1, 2) or the word "all".
# All instances share these GPU(s).
GPU_COUNT=1

# Fraction note: DGX Spark shares memory between CPU and GPU, and all instances
# run on the same GPU, so the GPU_MEM_UTIL_* of the ACTIVE models (those in
# COMPOSE_PROFILES) must sum to well under 1.0 or vLLM will OOM on startup.

# Open WebUI port.
WEBUI_PORT=3000

# Host directory holding the Wikipedia dense-retrieval index (the output of
# build_wiki_index.py: meta.json, passages.jsonl, index.faiss). Bind-mounted
# read-only to /index in the open-webui container for wiki_retriever_tool.py.
# Leave the tool's index_dir valve at its default (/index) to match.
WIKI_INDEX_DIR=./wiki_index
