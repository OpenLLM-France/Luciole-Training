# Copy to `.env` and edit. Used by docker-compose.yml.

# Model to serve. Either a Hugging Face id, or a path INSIDE the container
# under /models (see MODELS_DIR below), e.g. /models/luciole-tool-sft.
MODEL=OpenLLM-France/Luciole-1B-SFT-1.1

# Name the model is exposed as in the OpenAI API / Open WebUI picker.
SERVED_MODEL_NAME=luciole

# Must match how your model emits tool calls (hermes | llama3_json | mistral | ...).
TOOL_PARSER=hermes

# NVIDIA NGC vLLM container tag (ARM64/GB10 build for DGX Spark).
# Check the NGC catalog for the latest: catalog.ngc.nvidia.com/orgs/nvidia/containers/vllm
VLLM_TAG=26.02-py3

# Host dir holding local checkpoints; mounted to /models in the container.
MODELS_DIR=./models

# Host Hugging Face cache (avoids re-downloading on restart).
HF_CACHE=~/.cache/huggingface

# Needed only for gated/private HF models.
HF_TOKEN=

# GPUs to give vLLM: a number (e.g. 1, 2) or the word "all".
GPU_COUNT=1

# Fraction of (unified) GPU memory vLLM may use. DGX Spark shares memory
# between CPU and GPU, so keep this modest to avoid OOM. Lower if you hit OOM.
GPU_MEM_UTIL=0.5

# Host ports.
VLLM_PORT=8000
WEBUI_PORT=3000
