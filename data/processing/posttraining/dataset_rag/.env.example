# OpenAI-compatible endpoint used for generation and judging
LLM_BASE_URL="http://localhost:8000/v1/chat/completions"
LLM_API_KEY=""
LLM_MODEL=""
# optional: generator and judges on separate servers (default: the endpoint above).
# .env is read before the environment, so leave these out of .env when the DAG
# sets them (params gen_url / gen_key_file / judge_url / judge_key_file / judge_model).
#   LLM_GEN_BASE_URL, LLM_GEN_API_KEY_FILE
#   LLM_JUDGE_BASE_URL, LLM_JUDGE_API_KEY_FILE, LLM_JUDGE_MODEL
# optional: budget of reasoning judges (e.g. 6000 tokens, 1800 s)
#   LLM_JUDGE_MAX_TOKENS, LLM_JUDGE_TIMEOUT
# optional: OpenRouter judges (evaluate_and_filter.py --llm-judge-openrouter)
OPENROUTER_API=""
OPENROUTER_API_URL=""
